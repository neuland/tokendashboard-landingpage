---
import type { CollectionEntry } from 'astro:content';
import { AREA_LABEL } from '~/lib/decisions';

interface Props { decision: CollectionEntry<'decisions'> }
const { decision } = Astro.props;
const base = import.meta.env.BASE_URL;
const { title, summary, area } = decision.data;
---

<a class="card decision" href={`${base}decisions/${decision.id}/`}>
  <span class="pill">{AREA_LABEL[area]}</span>
  <h3>{title}</h3>
  <p>{summary}</p>
  <span class="decision__more">Read why →</span>
</a>

<style>
  .decision { display: flex; flex-direction: column; gap: 12px; text-decoration: none; color: inherit; transition: transform var(--ease), box-shadow var(--ease); }
  .decision:hover { transform: translateY(-2px); box-shadow: 0 2px 4px rgba(30,36,51,0.05), 0 18px 40px -14px rgba(30,36,51,0.25); }
  .decision > .pill { align-self: flex-start; }
  .decision h3 { font-size: 20px; }
  .decision p { font-size: 15px; }
  .decision__more { margin-top: auto; padding-top: 6px; font-size: var(--t-small); font-weight: 600; color: var(--accent-dark); }
  :global(.section--ink) .decision__more { color: #7FE0DB; }
  :global(.section--ink) .decision:hover { box-shadow: none; background: rgba(255,255,255,0.1); }
</style>
